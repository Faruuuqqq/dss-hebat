<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-10-17T14:50:00.000Z" agent="Antigravity IDE" version="24.0.0" type="device">
  <diagram id="diag_taksonomi_5_pola_dss" name="Taksonomi 5 Pola DSS">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot; color=&quot;#1e3a8a&quot;&gt;&lt;b&gt;TAKSONOMI LIMA POLA ARSITEKTUR DSS KESELAMATAN PERKOTAAN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#4b5563&quot;&gt;Sintesis Komparatif 12 Studi Primer Scopus (2021–2026) Berbasis Kebutuhan Data dan Status Adopsi di Jatinangor&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="300" y="15" width="750" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;div style=&quot;text-align: center; margin-bottom: 6px;&quot;&gt;&lt;font style=&quot;font-size:12px; font-weight:bold;&quot;&gt;POLA 1: GIS-MCDM&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px;&quot;&gt;Evaluasi Skenario Spasial&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#DCFCE7; color:#15803D; padding:3px 8px; border-radius:10px; font-weight:bold; font-size:10px;&quot;&gt;DIADOPSI (Core Engine)&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:0.5px solid #CBD5E1; margin:6px 0;&quot;&gt;&lt;b&gt;Studi Primer:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:10px;&quot;&gt;Feizizadeh (2025), Kabashkin (2025), Zheng (2025)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Karakteristik Input:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Data spasial jalan, crowd-sensor, DEMATEL-Bayesian, video UAV&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Decision Engine:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Spatial-MCDA, analisis multikriteria berbasis SIG&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Format Output:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Peta zonasi risiko segmen gang &amp; indeks keselamatan spasial&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Perlakuan di Jatinangor:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0F172A&quot; style=&quot;font-size:10px;&quot;&gt;Menjadi arsitektur inti model keputusan penempatan CCTV di gang permukiman.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="75" width="230" height="510" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;div style=&quot;text-align: center; margin-bottom: 6px;&quot;&gt;&lt;font style=&quot;font-size:12px; font-weight:bold;&quot;&gt;POLA 2: COVERAGE&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px;&quot;&gt;Optimasi Liputan Graf Jalan&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#DCFCE7; color:#15803D; padding:3px 8px; border-radius:10px; font-weight:bold; font-size:10px;&quot;&gt;DIADOPSI (Logika Liputan)&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:0.5px solid #CBD5E1; margin:6px 0;&quot;&gt;&lt;b&gt;Studi Primer:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:10px;&quot;&gt;Wang et al. (2025), Yuhang et al. (2025)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Karakteristik Input:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Topologi simpul jalan, radius coverage, data kepadatan penduduk (EWM)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Decision Engine:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Minimum Weighted Vertex Cover (MWVC), BCSLP + Genetic Algorithm&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Format Output:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Lokasi simpul kamera optimal &amp; pemotongan jumlah tiang/kamera&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Perlakuan di Jatinangor:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0F172A&quot; style=&quot;font-size:10px;&quot;&gt;Diserap ke dalam kriteria C4 (efisiensi coverage), C6 (simpul), dan C7 (gap).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="75" width="230" height="510" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;div style=&quot;text-align: center; margin-bottom: 6px;&quot;&gt;&lt;font style=&quot;font-size:12px; font-weight:bold;&quot;&gt;POLA 3: EXPERT-DRIVEN&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px;&quot;&gt;Survei Multistakeholder &amp; AHP&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#DCFCE7; color:#15803D; padding:3px 8px; border-radius:10px; font-weight:bold; font-size:10px;&quot;&gt;DIADOPSI (Skema Bobot)&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:0.5px solid #CBD5E1; margin:6px 0;&quot;&gt;&lt;b&gt;Studi Primer:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:10px;&quot;&gt;Ahmed (2022), Choi (2025), Baddour (2026)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Karakteristik Input:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Kuesioner preferensi pakar (Pemda, Kampus, Komunitas Warga/RT)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Decision Engine:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;AHP Hierarki 3 Kluster (10 perbandingan) &amp; Uji Konsistensi (CR &lt; 0,10)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Format Output:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Vektor bobot kriteria urgensi objektif (C1–C8) yang teraudit&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Perlakuan di Jatinangor:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0F172A&quot; style=&quot;font-size:10px;&quot;&gt;Menghindari kejenuhan responden dan menjaga konsistensi rasio konsensus.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="75" width="230" height="510" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;div style=&quot;text-align: center; margin-bottom: 6px;&quot;&gt;&lt;font style=&quot;font-size:12px; font-weight:bold;&quot;&gt;POLA 4: POLICY-MCDA&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px;&quot;&gt;Kerangka Rekomendasi Kebijakan&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#DCFCE7; color:#15803D; padding:3px 8px; border-radius:10px; font-weight:bold; font-size:10px;&quot;&gt;DIADOPSI (Alokasi Bertahap)&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:0.5px solid #CBD5E1; margin:6px 0;&quot;&gt;&lt;b&gt;Studi Primer:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:10px;&quot;&gt;Almassawa (2024), Shiddiqy (2025)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Karakteristik Input:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Indikator keamanan publik, dokumen kebijakan tata ruang &amp; regulasi&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Decision Engine:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;PROMETHEE, SWOT + AHP pembobotan strategis&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Format Output:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Rekomendasi alokasi bertahap &amp; rencana belanja implementasi&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Perlakuan di Jatinangor:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0F172A&quot; style=&quot;font-size:10px;&quot;&gt;Landasan modul alokasi tahunan (Fase 1, 2, 3) di bawah pagu Dana Desa.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="75" width="230" height="510" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="&lt;div style=&quot;text-align: center; margin-bottom: 6px;&quot;&gt;&lt;font style=&quot;font-size:12px; font-weight:bold;&quot;&gt;POLA 5: SIMULASI OPERASIONAL&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px;&quot;&gt;Prediktif-Probabilistik Real-Time&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#FEE2E2; color:#B91C1C; padding:3px 8px; border-radius:10px; font-weight:bold; font-size:10px;&quot;&gt;DITOLAK (Non-Transferable)&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:0.5px solid #CBD5E1; margin:6px 0;&quot;&gt;&lt;b&gt;Studi Primer:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:10px;&quot;&gt;Gonzalez-Villa et al. (2024) [S4AllCities]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Karakteristik Input:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Sensor pergerakan kontinu, estimasi korban, ancaman terorisme&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Decision Engine:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Prediktif-probabilistik, simulasi egress &amp; respons insiden taktis&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Format Output:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Rute evakuasi darurat dinamis &amp; manajemen kerumunan real-time&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Perlakuan di Jatinangor:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0F172A&quot; style=&quot;font-size:10px;&quot;&gt;DITOLAK karena membutuhkan kalibrasi sensor dinamis berbiaya tinggi yang tidak realistis untuk Jatinangor.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="75" width="230" height="510" as="geometry" />
        </mxCell>
        <mxCell id="synth_box" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;font style=&quot;font-size:13px;&quot; color=&quot;#1D4ED8&quot;&gt;&lt;b&gt;SINTESIS KONSEPTUAL MODEL KEPUTUSAN JATINANGOR (RQ3)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;table width=&quot;100%&quot; style=&quot;font-size:11px; margin-top:6px;&quot;&gt;&lt;tr&gt;&lt;td width=&quot;50%&quot; valign=&quot;top&quot;&gt;&lt;b&gt;1. Integrasi 4 Pola Teradopsi:&lt;/b&gt; Mengombinasikan &lt;i&gt;GIS-MCDM&lt;/i&gt; (lapisan spasial gang), &lt;i&gt;Optimasi Coverage&lt;/i&gt; (simpul kritis C6 &amp; gap C7), &lt;i&gt;Expert-Driven&lt;/i&gt; (AHP konsensus pakar), dan &lt;i&gt;Policy Framework&lt;/i&gt; (alokasi fase anggaran).&lt;br&gt;&lt;b&gt;2. Penolakan Sadar Pola Simulasi:&lt;/b&gt; Pola 5 ditolak demi kepraktisan karena permukiman mahasiswa tidak memiliki sensor kontinu.&lt;/td&gt;&lt;td width=&quot;50%&quot; valign=&quot;top&quot;&gt;&lt;b&gt;3. Kelayakan di Atas Data Diskrit:&lt;/b&gt; Beroperasi 100% menggunakan data lokal non-streaming (rekap Polsek C1, counting C2, survei lux C3, OpenStreetMap C4/C6/C8, profil kos C5, GPS kamera C7, dan RAB C9).&lt;br&gt;&lt;b&gt;4. Output Terukur:&lt;/b&gt; Menghasilkan skor kedekatan TOPSIS ($CC_i$), zonasi WebGIS, dan jadwal pengadaan bertahap di bawah plafon Rp 15 Juta.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="1230" height="150" as="geometry" />
        </mxCell>
        <mxCell id="e_p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.5;endArrow=classic;endFill=1;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1" target="synth_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.5;endArrow=classic;endFill=1;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2" target="synth_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.5;endArrow=classic;endFill=1;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3" target="synth_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.5;endArrow=classic;endFill=1;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p4" target="synth_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
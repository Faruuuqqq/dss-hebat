<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-10-17T14:50:00.000Z" agent="Antigravity IDE" version="24.0.0" type="device">
  <diagram id="diag_diagram_alir_prisma-scr" name="Diagram Alir PRISMA-ScR">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot; color=&quot;#1e3a8a&quot;&gt;&lt;b&gt;DIAGRAM ALIR PROTOKOL PRISMA-ScR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#4b5563&quot;&gt;Tahapan Seleksi Studi Literatur Decision Support System (DSS) untuk Smart Living and Urban Public Safety&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="240" y="15" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ph1" value="IDENTIFIKASI&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;opacity:0.9;&quot;&gt;(Identification)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="160" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ph2" value="PENJARINGAN&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;opacity:0.9;&quot;&gt;(Screening)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="160" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ph3" value="KELAYAKAN&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;opacity:0.9;&quot;&gt;(Eligibility)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="160" height="210" as="geometry" />
        </mxCell>
        <mxCell id="ph4" value="TERMASUK&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;opacity:0.9;&quot;&gt;(Included)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="160" height="130" as="geometry" />
        </mxCell>
        <mxCell id="box1" value="&lt;b&gt;Pencarian Sistematis Basis Data Scopus&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:11px;&quot;&gt;• Bidang: TITLE-ABS-KEY | Rentang: 2021–2026&lt;br&gt;• Konsep: Smart City AND DSS/MCDM AND Safety/CCTV&lt;br&gt;• Tanggal Eksekusi: 28 Maret 2026&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;&lt;b&gt;Total Rekaman Teridentifikasi (n = 582)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="70" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ex1" value="&lt;b&gt;Rekaman Dieliminasi Filter Otomatis (n = 401)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#991B1B&quot;&gt;• Terbit sebelum tahun 2021 (n = 166)&lt;br&gt;• Tipe dokumen non-artikel jurnal (n = 233)&lt;br&gt;• Naskah berbahasa non-Inggris (n = 2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontColor=#7F1D1D;fontSize=11;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="70" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="box2" value="&lt;b&gt;Pencarian Naskah Teks Lengkap&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:11px;&quot;&gt;(Reports sought for retrieval)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;&lt;b&gt;Laporan Dicari Teks Lengkapnya (n = 181)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="230" width="350" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ex2" value="&lt;b&gt;Laporan Tidak Dapat Diunduh (n = 60)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#991B1B&quot;&gt;• Batasan akses hak langganan institusi / paywall&lt;br&gt;(Dicatat jujur &amp; transparan sebagai limitasi scoping review)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontColor=#7F1D1D;fontSize=11;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="230" width="370" height="120" as="geometry" />
        </mxCell>
        <mxCell id="box3" value="&lt;b&gt;Penilaian Kelayakan Teks Lengkap&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:11px;&quot;&gt;(Reports assessed for full-text eligibility)&lt;br&gt;• Telaah independen oleh 5 penelaah (A1–A5)&lt;br&gt;• Diskusi konsensus untuk resolusi interpretasi&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;&lt;b&gt;Laporan Dinilai Kelayakan Substantif (n = 121)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="380" width="350" height="210" as="geometry" />
        </mxCell>
        <mxCell id="ex3" value="&lt;b&gt;Laporan Teks Lengkap Dieksklusi (n = 109)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#991B1B&quot;&gt;• Tanpa model keputusan / CV murni tanpa alokasi (n = 63)&lt;br&gt;• Di luar domain keselamatan publik permukiman (n = 28)&lt;br&gt;• Indeks makro komparasi antar-kota (n = 10)&lt;br&gt;• Naskah tinjauan pustaka sekunder / review (n = 5)&lt;br&gt;• Konteks spesifik non-transferable ke permukiman (n = 3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontColor=#7F1D1D;fontSize=11;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="380" width="370" height="210" as="geometry" />
        </mxCell>
        <mxCell id="box4" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#15803D&quot;&gt;&lt;b&gt;STUDI PRIMER DISERTAKAN DALAM SINTESIS (n = 12)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#166534&quot;&gt;• &lt;b&gt;GIS-MCDM:&lt;/b&gt; Feizizadeh &amp; Omarzadeh (2025), Kabashkin et al. (2025), Zheng et al. (2025)&lt;br&gt;• &lt;b&gt;Coverage Optimization:&lt;/b&gt; Wang et al. (2025), Yuhang et al. (2025)&lt;br&gt;• &lt;b&gt;Expert-Driven:&lt;/b&gt; Ahmed et al. (2022), Choi et al. (2025), Baddour et al. (2026)&lt;br&gt;• &lt;b&gt;Policy-MCDA:&lt;/b&gt; Almassawa et al. (2024), Shiddiqy et al. (2025)&lt;br&gt;• &lt;b&gt;Fuzzy AHP-TOPSIS:&lt;/b&gt; Kanj et al. (2024) | &lt;b&gt;Simulation-DSS:&lt;/b&gt; Gonzalez-Villa et al. (2024)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontColor=#14532D;fontSize=12;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="620" width="770" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=2;endArrow=classic;endFill=1;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="box1" target="box2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=2;endArrow=classic;endFill=1;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="box2" target="box3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=2;endArrow=classic;endFill=1;;exitX=0.5;exitY=1;entryX=0.22;entryY=0;" edge="1" parent="1" source="box3" target="box4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EF4444;strokeWidth=2;endArrow=classic;endFill=1;;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="box1" target="ex1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EF4444;strokeWidth=2;endArrow=classic;endFill=1;;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="box2" target="ex2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EF4444;strokeWidth=2;endArrow=classic;endFill=1;;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="box3" target="ex3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="diag_taksonomi_5_pola_dss" name="Taksonomi 5 Pola DSS">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot; color=&quot;#1e3a8a&quot;&gt;&lt;b&gt;TAKSONOMI LIMA POLA ARSITEKTUR DSS KESELAMATAN PERKOTAAN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#4b5563&quot;&gt;Sintesis Komparatif 12 Studi Primer Scopus (2021–2026) Berbasis Kebutuhan Data dan Status Adopsi di Jatinangor&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="300" y="15" width="750" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;div style=&quot;text-align: center; margin-bottom: 6px;&quot;&gt;&lt;font style=&quot;font-size:12px; font-weight:bold;&quot;&gt;POLA 1: GIS-MCDM&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px;&quot;&gt;Evaluasi Skenario Spasial&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#DCFCE7; color:#15803D; padding:3px 8px; border-radius:10px; font-weight:bold; font-size:10px;&quot;&gt;DIADOPSI (Core Engine)&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:0.5px solid #CBD5E1; margin:6px 0;&quot;&gt;&lt;b&gt;Studi Primer:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:10px;&quot;&gt;Feizizadeh (2025), Kabashkin (2025), Zheng (2025)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Karakteristik Input:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Data spasial jalan, crowd-sensor, DEMATEL-Bayesian, video UAV&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Decision Engine:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Spatial-MCDA, analisis multikriteria berbasis SIG&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Format Output:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Peta zonasi risiko segmen gang &amp; indeks keselamatan spasial&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Perlakuan di Jatinangor:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0F172A&quot; style=&quot;font-size:10px;&quot;&gt;Menjadi arsitektur inti model keputusan penempatan CCTV di gang permukiman.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="75" width="230" height="510" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;div style=&quot;text-align: center; margin-bottom: 6px;&quot;&gt;&lt;font style=&quot;font-size:12px; font-weight:bold;&quot;&gt;POLA 2: COVERAGE&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px;&quot;&gt;Optimasi Liputan Graf Jalan&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#DCFCE7; color:#15803D; padding:3px 8px; border-radius:10px; font-weight:bold; font-size:10px;&quot;&gt;DIADOPSI (Logika Liputan)&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:0.5px solid #CBD5E1; margin:6px 0;&quot;&gt;&lt;b&gt;Studi Primer:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:10px;&quot;&gt;Wang et al. (2025), Yuhang et al. (2025)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Karakteristik Input:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Topologi simpul jalan, radius coverage, data kepadatan penduduk (EWM)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Decision Engine:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Minimum Weighted Vertex Cover (MWVC), BCSLP + Genetic Algorithm&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Format Output:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Lokasi simpul kamera optimal &amp; pemotongan jumlah tiang/kamera&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Perlakuan di Jatinangor:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0F172A&quot; style=&quot;font-size:10px;&quot;&gt;Diserap ke dalam kriteria C4 (efisiensi coverage), C6 (simpul), dan C7 (gap).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="75" width="230" height="510" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;div style=&quot;text-align: center; margin-bottom: 6px;&quot;&gt;&lt;font style=&quot;font-size:12px; font-weight:bold;&quot;&gt;POLA 3: EXPERT-DRIVEN&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px;&quot;&gt;Survei Multistakeholder &amp; AHP&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#DCFCE7; color:#15803D; padding:3px 8px; border-radius:10px; font-weight:bold; font-size:10px;&quot;&gt;DIADOPSI (Skema Bobot)&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:0.5px solid #CBD5E1; margin:6px 0;&quot;&gt;&lt;b&gt;Studi Primer:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:10px;&quot;&gt;Ahmed (2022), Choi (2025), Baddour (2026)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Karakteristik Input:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Kuesioner preferensi pakar (Pemda, Kampus, Komunitas Warga/RT)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Decision Engine:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;AHP Hierarki 3 Kluster (10 perbandingan) &amp; Uji Konsistensi (CR &lt; 0,10)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Format Output:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Vektor bobot kriteria urgensi objektif (C1–C8) yang teraudit&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Perlakuan di Jatinangor:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0F172A&quot; style=&quot;font-size:10px;&quot;&gt;Menghindari kejenuhan responden dan menjaga konsistensi rasio konsensus.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="75" width="230" height="510" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;div style=&quot;text-align: center; margin-bottom: 6px;&quot;&gt;&lt;font style=&quot;font-size:12px; font-weight:bold;&quot;&gt;POLA 4: POLICY-MCDA&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px;&quot;&gt;Kerangka Rekomendasi Kebijakan&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#DCFCE7; color:#15803D; padding:3px 8px; border-radius:10px; font-weight:bold; font-size:10px;&quot;&gt;DIADOPSI (Alokasi Bertahap)&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:0.5px solid #CBD5E1; margin:6px 0;&quot;&gt;&lt;b&gt;Studi Primer:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:10px;&quot;&gt;Almassawa (2024), Shiddiqy (2025)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Karakteristik Input:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Indikator keamanan publik, dokumen kebijakan tata ruang &amp; regulasi&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Decision Engine:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;PROMETHEE, SWOT + AHP pembobotan strategis&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Format Output:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Rekomendasi alokasi bertahap &amp; rencana belanja implementasi&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Perlakuan di Jatinangor:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0F172A&quot; style=&quot;font-size:10px;&quot;&gt;Landasan modul alokasi tahunan (Fase 1, 2, 3) di bawah pagu Dana Desa.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="75" width="230" height="510" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="&lt;div style=&quot;text-align: center; margin-bottom: 6px;&quot;&gt;&lt;font style=&quot;font-size:12px; font-weight:bold;&quot;&gt;POLA 5: SIMULASI OPERASIONAL&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px;&quot;&gt;Prediktif-Probabilistik Real-Time&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#FEE2E2; color:#B91C1C; padding:3px 8px; border-radius:10px; font-weight:bold; font-size:10px;&quot;&gt;DITOLAK (Non-Transferable)&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:0.5px solid #CBD5E1; margin:6px 0;&quot;&gt;&lt;b&gt;Studi Primer:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:10px;&quot;&gt;Gonzalez-Villa et al. (2024) [S4AllCities]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Karakteristik Input:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Sensor pergerakan kontinu, estimasi korban, ancaman terorisme&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Decision Engine:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Prediktif-probabilistik, simulasi egress &amp; respons insiden taktis&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Format Output:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px;&quot;&gt;Rute evakuasi darurat dinamis &amp; manajemen kerumunan real-time&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Perlakuan di Jatinangor:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0F172A&quot; style=&quot;font-size:10px;&quot;&gt;DITOLAK karena membutuhkan kalibrasi sensor dinamis berbiaya tinggi yang tidak realistis untuk Jatinangor.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="75" width="230" height="510" as="geometry" />
        </mxCell>
        <mxCell id="synth_box" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;font style=&quot;font-size:13px;&quot; color=&quot;#1D4ED8&quot;&gt;&lt;b&gt;SINTESIS KONSEPTUAL MODEL KEPUTUSAN JATINANGOR (RQ3)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;table width=&quot;100%&quot; style=&quot;font-size:11px; margin-top:6px;&quot;&gt;&lt;tr&gt;&lt;td width=&quot;50%&quot; valign=&quot;top&quot;&gt;&lt;b&gt;1. Integrasi 4 Pola Teradopsi:&lt;/b&gt; Mengombinasikan &lt;i&gt;GIS-MCDM&lt;/i&gt; (lapisan spasial gang), &lt;i&gt;Optimasi Coverage&lt;/i&gt; (simpul kritis C6 &amp; gap C7), &lt;i&gt;Expert-Driven&lt;/i&gt; (AHP konsensus pakar), dan &lt;i&gt;Policy Framework&lt;/i&gt; (alokasi fase anggaran).&lt;br&gt;&lt;b&gt;2. Penolakan Sadar Pola Simulasi:&lt;/b&gt; Pola 5 ditolak demi kepraktisan karena permukiman mahasiswa tidak memiliki sensor kontinu.&lt;/td&gt;&lt;td width=&quot;50%&quot; valign=&quot;top&quot;&gt;&lt;b&gt;3. Kelayakan di Atas Data Diskrit:&lt;/b&gt; Beroperasi 100% menggunakan data lokal non-streaming (rekap Polsek C1, counting C2, survei lux C3, OpenStreetMap C4/C6/C8, profil kos C5, GPS kamera C7, dan RAB C9).&lt;br&gt;&lt;b&gt;4. Output Terukur:&lt;/b&gt; Menghasilkan skor kedekatan TOPSIS ($CC_i$), zonasi WebGIS, dan jadwal pengadaan bertahap di bawah plafon Rp 15 Juta.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="1230" height="150" as="geometry" />
        </mxCell>
        <mxCell id="e_p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.5;endArrow=classic;endFill=1;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1" target="synth_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.5;endArrow=classic;endFill=1;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2" target="synth_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.5;endArrow=classic;endFill=1;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3" target="synth_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.5;endArrow=classic;endFill=1;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p4" target="synth_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="diag_arsitektur_4_lapisan_dss" name="Arsitektur 4 Lapisan DSS">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot; color=&quot;#1e3a8a&quot;&gt;&lt;b&gt;ARSITEKTUR KONSEPTUAL EMPAT LAPISAN DSS PRIORITISASI CCTV JATINANGOR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#4b5563&quot;&gt;Pemisahan Tegas Antara Kriteria Urgensi Risiko (C1–C8) dan Kendala Kelayakan Fisik &amp; Anggaran Belanja (C9 &amp; RAB)&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="250" y="15" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="l1_container" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1120" height="175" as="geometry" />
        </mxCell>
        <mxCell id="l1_badge" value="LAPISAN 1: INPUT DATA DISKRIT LOKAL" style="text;html=1;fontStyle=1;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="55" y="78" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="l1_urgensi" value="&lt;b&gt;Modul Kriteria Urgensi Risiko (C1–C8) [Benefit-Oriented]&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:10.5px;&quot;&gt;• &lt;b&gt;C1: Riwayat Kerawanan&lt;/b&gt; (kejadian/km/th) [Rekap Polsek / Ketua RT]&lt;br&gt;• &lt;b&gt;C2: Volume Mobilitas Malam&lt;/b&gt; (orang &amp; motor/jam) [Counting manual malam]&lt;br&gt;• &lt;b&gt;C3: Defisiensi Penerangan&lt;/b&gt; (skor lux 1–5: makin gelap makin butuh) [Survei visibilitas]&lt;br&gt;• &lt;b&gt;C4: Efisiensi Coverage&lt;/b&gt; (m²/titik: luas pandang terawasi) [OpenStreetMap &amp; geometri]&lt;br&gt;• &lt;b&gt;C5: Kepadatan Kos&lt;/b&gt; (kamar aktif/km) [Data desa &amp; paguyuban kos]&lt;br&gt;• &lt;b&gt;C6: Derajat Simpul&lt;/b&gt; (jumlah cabang persimpangan gang) [Graf jalan OpenStreetMap]&lt;br&gt;• &lt;b&gt;C7: Coverage Gap CCTV&lt;/b&gt; (jarak meter ke kamera aktif terdekat) [Survei GPS kamera]&lt;br&gt;• &lt;b&gt;C8: Fasilitas Rentan&lt;/b&gt; (unit POI indekos, ATM, halte radius 150m) [OSM POI]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="55" y="105" width="680" height="125" as="geometry" />
        </mxCell>
        <mxCell id="l1_kelayakan" value="&lt;b&gt;Modul Kelayakan &amp; Anggaran Fisik&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:10.5px;&quot;&gt;• &lt;b&gt;C9: Kelayakan Implementasi Teknis&lt;/b&gt;&lt;br&gt;  (skor 1–5: kesiapan tiang fisik, pasokan listrik PLN, dan sinyal internet)&lt;br&gt;• &lt;b&gt;Estimasi Biaya Pengadaan (RAB):&lt;/b&gt;&lt;br&gt;  (Rp 5–8 Juta/titik: kamera IP outdoor, braket tiang PJU/PLN, kabel daya &amp; adaptor)&lt;br&gt;• &lt;b&gt;Pagu Plafon Anggaran Belanja Tahunan:&lt;/b&gt;&lt;br&gt;  ($B_k \le \text{Rp } 15.000.000$,- per tahun alokasi)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="750" y="105" width="395" height="125" as="geometry" />
        </mxCell>
        <mxCell id="l2_container" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="275" width="1120" height="140" as="geometry" />
        </mxCell>
        <mxCell id="l2_badge" value="LAPISAN 2: PREPROCESSING &amp; KODIFIKASI DATA" style="text;html=1;fontStyle=1;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="55" y="283" width="350" height="25" as="geometry" />
        </mxCell>
        <mxCell id="l2_p1" value="&lt;b&gt;Kodifikasi Alternatif&lt;/b&gt;&lt;br&gt;5 Tipologi Spasial Gang&lt;br&gt;(Sayang, Cikeruh, Hegarmanah,&lt;br&gt;Cipacing, Cileles / A1–A5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#1E293B;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="310" width="255" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l2_p2" value="&lt;b&gt;Pembersihan &amp; Validasi&lt;/b&gt;&lt;br&gt;Penyeragaman satuan rasio,&lt;br&gt;agregasi koordinat GPS,&lt;br&gt;&amp; validasi silang data Polsek/RT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#1E293B;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="310" width="255" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l2_p3" value="&lt;b&gt;Normalisasi Vektor Euclidean&lt;/b&gt;&lt;br&gt;Transformasi nir-dimensi C1–C8:&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;$r_{ij} = x_{ij} / \sqrt{\sum_{k=1}^m x_{kj}^2}$&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#1E293B;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="605" y="310" width="265" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l2_p4" value="&lt;b&gt;Filter Batas Kelayakan Teknis&lt;/b&gt;&lt;br&gt;Eliminasi segmen dengan daya/tiang nihil:&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;Ambang batas $C9_i \ge 3$&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#1E293B;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="890" y="310" width="255" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l3_container" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="445" width="1120" height="230" as="geometry" />
        </mxCell>
        <mxCell id="l3_badge" value="LAPISAN 3: DECISION ENGINE (MCDM HYBRID &amp; ANGGARAN)" style="text;html=1;fontStyle=1;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="55" y="453" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="l3_ahp" value="&lt;b&gt;Engine 1: AHP Hierarki 3 Kluster&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4C1D95&quot;&gt;• &lt;b&gt;Kluster Risiko:&lt;/b&gt; C1 (24,31%), C3 (14,58%)&lt;br&gt;• &lt;b&gt;Kluster Paparan:&lt;/b&gt; C2 (14,20%), C5 (12,35%), C8 (12,35%)&lt;br&gt;• &lt;b&gt;Kluster Spasial:&lt;/b&gt; C7 (9,56%), C4 (7,61%), C6 (5,05%)&lt;br&gt;• 10 Perbandingan berpasangan (hemat dari 28 pasang)&lt;br&gt;• Konsensus Geometric Mean 3 Kelompok (Pemda, Kampus, RT)&lt;br&gt;• Teruji konsisten per matriks: &lt;b&gt;CR = 0,0000 &amp;lt; 0,10&lt;/b&gt;&lt;br&gt;• Formula Bobot Global: $w_j = W_k \times w_{j|k}$&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;fontSize=10.5;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="55" y="480" width="370" height="180" as="geometry" />
        </mxCell>
        <mxCell id="l3_topsis" value="&lt;b&gt;Engine 2: Perankingan TOPSIS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1E40AF&quot;&gt;• Pembobotan Matriks: $v_{ij} = w_j \cdot r_{ij}$&lt;br&gt;• Solusi Ideal Positif: $A^+ = \{\max_i(v_{ij})\}$&lt;br&gt;• Solusi Ideal Negatif: $A^- = \{\min_i(v_{ij})\}$&lt;br&gt;• Jarak Euclidean: $D_i^+$ dan $D_i^-$&lt;br&gt;• Skor Kedekatan Relatif: &lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;$CC_i = \frac{D_i^-}{D_i^+ + D_i^-}$&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Hasil: A3 (0,6441) &amp;gt; A1 (0,5809) &amp;gt; A4 (0,5036) &amp;gt; A2 (0,4608) &amp;gt; A5 (0,1819)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;fontSize=10.5;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="445" y="480" width="360" height="180" as="geometry" />
        </mxCell>
        <mxCell id="l3_budget" value="&lt;b&gt;Engine 3: Kendala Anggaran &amp; OAT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#78350F&quot;&gt;• &lt;b&gt;Partisi Fase Anggaran:&lt;/b&gt; $\sum \text{Cost}_i \le B_k$&lt;br&gt;• Plafon belanja Rp 15 Jt/tahun (Dana Desa / Swadaya RW)&lt;br&gt;• &lt;b&gt;Rasio Efisiensi Urgensi-Biaya:&lt;/b&gt; $CC_i / \text{Cost}_i$&lt;br&gt;  (Panduan pendukung keputusan bila ada selisih biaya tajam)&lt;br&gt;• &lt;b&gt;Uji Sensitivitas OAT $\pm 20\%$ (16 Run):&lt;/b&gt;&lt;br&gt;  Peringkat A3 &amp; A1 kokoh di posisi 1 &amp; 2;&lt;br&gt;  Dinamika A4 vs A2 memvalidasi penggabungan di Fase 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;fontSize=10.5;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="825" y="480" width="320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="l4_container" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="705" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="l4_badge" value="LAPISAN 4: KELUARAN TINDAKAN (ACTIONABLE OUTPUT)" style="text;html=1;fontStyle=1;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="55" y="713" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="l4_rank" value="&lt;b&gt;Peringkat Urgensi CCTV&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#15803D&quot;&gt;1. A3 (Persimpangan Hegarmanah): $CC=0,6441$&lt;br&gt;2. A1 (Gang Kos Sayang): $CC=0,5809$&lt;br&gt;3. A4 (Gang Cipacing): $CC=0,5036$&lt;br&gt;4. A2 (Ruas Jalan Cikeruh): $CC=0,4608$&lt;br&gt;5. A5 (Ruas Jalan Cileles): $CC=0,1819$&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="55" y="740" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l4_gis" value="&lt;b&gt;Peta Zonasi Spasial GIS&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#1D4ED8&quot;&gt;• WebGIS / QGIS Layer Prioritas Gang&lt;br&gt;• Penandaan Titik Pasang Kamera Eksisting &amp; Baru&lt;br&gt;• Visualisasi Blind Zone &amp; Area Pengawasan CPTED&lt;br&gt;• Papan Peringatan Fisik Sesuai UU PDP No. 27/2022&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1E40AF;" vertex="1" parent="1">
          <mxGeometry x="415" y="740" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l4_phase" value="&lt;b&gt;Rencana Alokasi Belanja Bertahap&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#92400E&quot;&gt;• &lt;b&gt;Fase 1 (Tahun 1):&lt;/b&gt; A3 (Rp 7,5 Jt) + A1 (Rp 6,5 Jt) = Rp 14 Jt&lt;br&gt;• &lt;b&gt;Fase 2 (Tahun 2):&lt;/b&gt; A4 (Rp 8,0 Jt) + A2 (Rp 5,0 Jt) = Rp 13 Jt&lt;br&gt;• &lt;b&gt;Fase 3 (Tahun 3):&lt;/b&gt; A5 (Rp 5,5 Jt) = Rp 5,5 Jt&lt;br&gt;&lt;b&gt;Status: Terlaksana di bawah pagu Rp 15 Juta/tahun&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="795" y="740" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="el1_l2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=classic;endFill=1;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="l1_container" target="l2_container">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="el2_l3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=classic;endFill=1;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="l2_container" target="l3_container">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="el3_l4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=classic;endFill=1;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="l3_container" target="l4_container">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_eng1" value="Bobot w_j" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=1.5;dashed=1;endArrow=classic;endFill=1;;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="l3_ahp" target="l3_topsis">

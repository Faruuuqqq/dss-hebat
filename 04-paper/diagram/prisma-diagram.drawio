        <mxCell id="box4" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#15803D&quot;&gt;&lt;b&gt;STUDI PRIMER DISERTAKAN DALAM SINTESIS (n = 12)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#166534&quot;&gt;• &lt;b&gt;GIS-MCDM:&lt;/b&gt; Feizizadeh &amp; Omarzadeh (2025), Kabashkin et al. (2025), Zheng et al. (2025)&lt;br&gt;• &lt;b&gt;Coverage Optimization:&lt;/b&gt; Wang et al. (2025), Yuhang et al. (2025)&lt;br&gt;• &lt;b&gt;Expert-Driven:&lt;/b&gt; Ahmed et al. (2022), Choi et al. (2025), Baddour et al. (2026)&lt;br&gt;• &lt;b&gt;Policy-MCDA:&lt;/b&gt; Almassawa et al. (2024), Shiddiqy et al. (2025)&lt;br&gt;• &lt;b&gt;Fuzzy AHP-TOPSIS:&lt;/b&gt; Kanj et al. (2024) | &lt;b&gt;Simulation-DSS:&lt;/b&gt; Gonzalez-Villa et al. (2024)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontColor=#14532D;fontSize=12;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;shadow=1;" vertex="1" parent="1">

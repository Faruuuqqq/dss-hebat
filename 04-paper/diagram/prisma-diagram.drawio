        <mxCell id="ph4" value="TERMASUK&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;opacity:0.9;&quot;&gt;(Included)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="160" height="130" as="geometry" />
        </mxCell>
        <mxCell id="box1" value="&lt;b&gt;Pencarian Sistematis Basis Data Scopus&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:11px;&quot;&gt;• Bidang: TITLE-ABS-KEY | Rentang: 2021–2026&lt;br&gt;• Konsep: Smart City AND DSS/MCDM AND Safety/CCTV&lt;br&gt;• Tanggal Eksekusi: 28 Maret 2026&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;&lt;b&gt;Total Rekaman Teridentifikasi (n = 582)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="70" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ex1" value="&lt;b&gt;Rekaman Dieliminasi Filter Otomatis (n = 401)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#991B1B&quot;&gt;• Terbit sebelum tahun 2021 (n = 166)&lt;br&gt;• Tipe dokumen non-artikel jurnal (n = 233)&lt;br&gt;• Naskah berbahasa non-Inggris (n = 2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontColor=#7F1D1D;fontSize=11;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="70" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="box2" value="&lt;b&gt;Pencarian Naskah Teks Lengkap&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:11px;&quot;&gt;(Reports sought for retrieval)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;&lt;b&gt;Laporan Dicari Teks Lengkapnya (n = 181)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="230" width="350" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ex2" value="&lt;b&gt;Laporan Tidak Dapat Diunduh (n = 60)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#991B1B&quot;&gt;• Batasan akses hak langganan institusi / paywall&lt;br&gt;(Dicatat jujur &amp; transparan sebagai limitasi scoping review)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontColor=#7F1D1D;fontSize=11;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="230" width="370" height="120" as="geometry" />
        </mxCell>
        <mxCell id="box3" value="&lt;b&gt;Penilaian Kelayakan Teks Lengkap&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:11px;&quot;&gt;(Reports assessed for full-text eligibility)&lt;br&gt;• Telaah independen oleh 5 penelaah (A1–A5)&lt;br&gt;• Diskusi konsensus untuk resolusi interpretasi&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;&lt;b&gt;Laporan Dinilai Kelayakan Substantif (n = 121)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="380" width="350" height="210" as="geometry" />
        </mxCell>
        <mxCell id="ex3" value="&lt;b&gt;Laporan Teks Lengkap Dieksklusi (n = 109)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#991B1B&quot;&gt;• Tanpa model keputusan / CV murni tanpa alokasi (n = 63)&lt;br&gt;• Di luar domain keselamatan publik permukiman (n = 28)&lt;br&gt;• Indeks makro komparasi antar-kota (n = 10)&lt;br&gt;• Naskah tinjauan pustaka sekunder / review (n = 5)&lt;br&gt;• Konteks spesifik non-transferable ke permukiman (n = 3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontColor=#7F1D1D;fontSize=11;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
